            {
              "id": "AES-128",
              "name": "Aes128Usage",
              "shortDescription": {
                "text": "AES-128 (approved, below strictest profile)"
              },
              "fullDescription": {
                "text": "AES-128: Weakened, not broken, by Grover's algorithm. Grover's algorithm weakens but does not break AES-128; NIST still approves it. CNSA 2.0 requires AES-256."
              },
              "help": {
                "text": "AES-128: Weakened, not broken, by Grover's algorithm. Grover's algorithm weakens but does not break AES-128; NIST still approves it. CNSA 2.0 requires AES-256. Recommended replacement: AES-256 where policy requires it."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "block-cipher"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "AES-000",
              "name": "AesKeySizeNotStatedUsage",
              "shortDescription": {
                "text": "AES (key size not stated) (needs a human to confirm)"
              },
              "fullDescription": {
                "text": "AES (key size not stated): Weakened, not broken, by Grover's algorithm. The key length is set at runtime and cannot be read statically."
              },
              "help": {
                "text": "AES (key size not stated): Weakened, not broken, by Grover's algorithm. The key length is set at runtime and cannot be read statically. Recommended replacement: Confirm the key length; use 256-bit keys."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "block-cipher"
                ],
                "security-severity": "1.0"
              }
            },
            {
              "id": "3DES-001",
              "name": "3DesUsage",
              "shortDescription": {
                "text": "3DES (classically weak, replace regardless)"
              },
              "fullDescription": {
                "text": "3DES: Weak against classical attacks today. 64-bit block (Sweet32) and 112-bit strength."
              },
              "help": {
                "text": "3DES: Weak against classical attacks today. 64-bit block (Sweet32) and 112-bit strength. Recommended replacement: AES-256 (GCM) or ChaCha20-Poly1305."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "block-cipher"
                ],
                "security-severity": "7.0"
              }
            },
            {
              "id": "RC4-001",
              "name": "Rc4Usage",
              "shortDescription": {
                "text": "RC4 (classically weak, replace regardless)"
              },
              "fullDescription": {
                "text": "RC4: Weak against classical attacks today. Biased keystream; prohibited in TLS (RFC 7465)."
              },
              "help": {
                "text": "RC4: Weak against classical attacks today. Biased keystream; prohibited in TLS (RFC 7465). Recommended replacement: AES-256 (GCM) or ChaCha20-Poly1305."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "stream-cipher"
                ],
                "security-severity": "7.0"
              }
            },
            {
