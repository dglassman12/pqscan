              "name": "Md5Usage",
              "shortDescription": {
                "text": "MD5 (classically weak, replace regardless)"
              },
              "fullDescription": {
                "text": "MD5: Weak against classical attacks today. Practical collisions since 2004."
              },
              "help": {
                "text": "MD5: Weak against classical attacks today. Practical collisions since 2004. Recommended replacement: SHA-256 or stronger (SHA-384 for CNSA 2.0)."
              },
