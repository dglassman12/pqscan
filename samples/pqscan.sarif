          "rules": [
            {
              "id": "RSA-001",
              "name": "RsaUsage",
              "shortDescription": {
                "text": "RSA (quantum-vulnerable public-key crypto)"
              },
              "fullDescription": {
                "text": "RSA: Broken by Shor's algorithm on a cryptographically relevant quantum computer."
              },
              "help": {
                "text": "RSA: Broken by Shor's algorithm on a cryptographically relevant quantum computer. Recommended replacement: ML-KEM (FIPS 203) for key establishment and encryption; ML-DSA (FIPS 204) or SLH-DSA (FIPS 205) for signatures."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "pke"
                ],
                "security-severity": "9.0"
              }
            },
            {
